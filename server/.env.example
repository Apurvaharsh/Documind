PORT=5000

# Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/documind"

# Redis - required for the BullMQ document queue
REDIS_HOST="localhost"
REDIS_PORT=6379

# Python AI service
AI_SERVICE_URL=http://localhost:8000

# Qdrant vector DB
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Must match ai-service/.env exactly - see the note there about why each
# environment needs its own collection.
QDRANT_COLLECTION=pdf-docs-dev
EMBEDDING_DIM=768

# Clerk auth
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173
